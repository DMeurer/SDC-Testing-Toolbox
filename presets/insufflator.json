{
  "version": 3,
  "name": "Insufflator",
  "description": "Laparoscopic insufflator: nine metrics for gas flow, pressure control, and related alarms. One metric larger than the infusion pump, and the first preset this project had.",
  "device": {
    "instance_name": "insufflator",
    "friendly_name": "Insufflator",
    "manufacturer": "SDC Testing Toolbox",
    "manufacturer_url": "https://d-meurer.com",
    "model_name": "Pneumo 40",
    "model_number": "40",
    "firmware_version": "1.4.0"
  },
  "metrics": [
    {
      "handle": "m.flow_rate",
      "label": "Flow rate",
      "kind": "number",
      "controllable": true,
      "section": "Gas",
      "unit": {
        "code": "MDC_DIM_L_PER_MIN",
        "system": "mdc",
        "label": "L/min"
      },
      "type": {
        "code": "insuf_flow_rate",
        "system": "private"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "40",
      "initial_value": "15"
    },
    {
      "handle": "m.flow_spectrum",
      "label": "Flow spectrum",
      "kind": "distribution",
      "controllable": false,
      "section": "Pressure",
      "unit": {
        "code": "MDC_DIM_DECIBEL",
        "system": "mdc",
        "label": "dB"
      },
      "type": {
        "code": "insuf_flow_spectrum",
        "system": "private"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "40",
      "domain_unit": {
        "code": "MDC_DIM_HZ",
        "system": "mdc",
        "label": "Hz"
      },
      "domain_minimum": "0",
      "domain_maximum": "50",
      "distribution_shape": "spectrum"
    },
    {
      "handle": "m.gas_supply",
      "label": "Gas supply",
      "kind": "choice",
      "controllable": false,
      "section": "Gas",
      "type": {
        "code": "insuf_gas_supply",
        "system": "private"
      },
      "allowed_values": [
        "OK",
        "LOW",
        "EMPTY"
      ],
      "initial_value": "OK"
    },
    {
      "handle": "m.gas_used",
      "label": "Gas used",
      "kind": "number",
      "controllable": false,
      "section": "Gas",
      "unit": {
        "code": "MDC_DIM_L",
        "system": "mdc",
        "label": "L"
      },
      "type": {
        "code": "insuf_gas_used",
        "system": "private"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "500",
      "initial_value": "3.4"
    },
    {
      "handle": "m.measured_pressure",
      "label": "Measured pressure",
      "kind": "number",
      "controllable": false,
      "section": "Pressure",
      "unit": {
        "code": "MDC_DIM_MMHG",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "insuf_measured_pressure",
        "system": "private"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "60",
      "initial_value": "12"
    },
    {
      "handle": "m.mode",
      "label": "Mode",
      "kind": "choice",
      "controllable": true,
      "section": "Control",
      "type": {
        "code": "insuf_mode",
        "system": "private"
      },
      "allowed_values": [
        "STANDBY",
        "INSUFFLATING",
        "PAUSED"
      ],
      "initial_value": "STANDBY"
    },
    {
      "handle": "m.operator_note",
      "label": "Operator note",
      "kind": "text",
      "controllable": true,
      "section": "Control",
      "type": {
        "code": "insuf_operator_note",
        "system": "private"
      }
    },
    {
      "handle": "m.pressure_trace",
      "label": "Pressure trace",
      "kind": "waveform",
      "controllable": false,
      "section": "Pressure",
      "unit": {
        "code": "MDC_DIM_MMHG",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "insuf_pressure_trace",
        "system": "private"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "30",
      "sample_period": "0.1",
      "shape": "respiration",
      "cycle_samples": 60
    },
    {
      "handle": "m.target_pressure",
      "label": "Target pressure",
      "kind": "number",
      "controllable": true,
      "section": "Pressure",
      "unit": {
        "code": "MDC_DIM_MMHG",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "insuf_target_pressure",
        "system": "private"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "30",
      "initial_value": "12"
    }
  ],
  "alerts": [
    {
      "handle": "al.flow_out_of_range",
      "label": "Flow out of range",
      "watches": "m.flow_rate",
      "kind": "Tec",
      "priority": "Me",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "1",
      "upper_limit": "35"
    },
    {
      "handle": "al.overpressure",
      "label": "Overpressure",
      "watches": "m.measured_pressure",
      "kind": "Phy",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "upper_limit": "20",
      "delegable": true
    },
    {
      "handle": "al.service_due",
      "label": "Service due",
      "watches": "m.flow_rate",
      "kind": "Oth",
      "priority": "Lo",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ]
    }
  ],
  "actions": [
    {
      "handle": "act.reset_gas_used",
      "label": "Reset gas counter",
      "target": "vmd.gas",
      "effects": {
        "m.gas_used": "0"
      }
    },
    {
      "handle": "act.vent",
      "label": "Vent to atmosphere",
      "target": "vmd.pressure",
      "note": "Release the pneumoperitoneum. One press, and nothing to type",
      "effects": {
        "m.flow_rate": "0",
        "m.measured_pressure": "0",
        "m.mode": "STANDBY"
      }
    }
  ],
  "contexts": {
    "location": {
      "facility": "HOSP",
      "building": "Surgery",
      "floor": "2",
      "point_of_care": "OR1",
      "room": "1",
      "bed": "Table"
    }
  }
}
