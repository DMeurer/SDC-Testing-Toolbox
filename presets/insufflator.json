{
  "version": 1,
  "name": "Insufflator",
  "description": "Eight data sources and three alarms, roughly what a laparoscopic insufflator publishes.",
  "device": {
    "instance_name": "insufflator",
    "friendly_name": "Example insufflator"
  },
  "contexts": {
    "location": {
      "facility": "HOSP",
      "building": "Surgery",
      "floor": "2",
      "point_of_care": "OR1",
      "room": "1",
      "bed": "Table"
    }
  },
  "metrics": [
    {
      "handle": "m.flow_rate",
      "label": "Flow rate",
      "kind": "number",
      "controllable": true,
      "unit": "L/min",
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "40",
      "initial_value": "15"
    },
    {
      "handle": "m.target_pressure",
      "label": "Target pressure",
      "kind": "number",
      "controllable": true,
      "unit": "mmHg",
      "resolution": "1",
      "minimum": "0",
      "maximum": "30",
      "initial_value": "12"
    },
    {
      "handle": "m.measured_pressure",
      "label": "Measured pressure",
      "kind": "number",
      "controllable": false,
      "unit": "mmHg",
      "resolution": "1",
      "minimum": "0",
      "maximum": "60",
      "initial_value": "12"
    },
    {
      "handle": "m.mode",
      "label": "Mode",
      "kind": "choice",
      "controllable": true,
      "allowed_values": ["STANDBY", "INSUFFLATING", "PAUSED"],
      "initial_value": "STANDBY"
    },
    {
      "handle": "m.gas_supply",
      "label": "Gas supply",
      "kind": "choice",
      "controllable": false,
      "allowed_values": ["OK", "LOW", "EMPTY"],
      "initial_value": "OK"
    },
    {
      "handle": "m.operator_note",
      "label": "Operator note",
      "kind": "text",
      "controllable": true
    },
    {
      "handle": "m.pressure_trace",
      "label": "Pressure trace",
      "kind": "waveform",
      "controllable": false,
      "unit": "mmHg",
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "30",
      "sample_period": "0.1",
      "shape": "sine"
    },
    {
      "handle": "m.flow_spectrum",
      "label": "Flow spectrum",
      "kind": "distribution",
      "controllable": false,
      "unit": "dB",
      "resolution": "0.1",
      "domain_unit": "Hz",
      "domain_minimum": "0",
      "domain_maximum": "50"
    }
  ],
  "alerts": [
    {
      "handle": "al.overpressure",
      "label": "Overpressure",
      "watches": "m.measured_pressure",
      "kind": "Phy",
      "priority": "Hi",
      "upper_limit": "20",
      "delegable": true
    },
    {
      "handle": "al.flow_out_of_range",
      "label": "Flow out of range",
      "watches": "m.flow_rate",
      "kind": "Tec",
      "priority": "Me",
      "lower_limit": "1",
      "upper_limit": "35"
    },
    {
      "handle": "al.service_due",
      "label": "Service due",
      "watches": "m.flow_rate",
      "kind": "Oth",
      "priority": "Lo"
    }
  ]
}
