{
  "version": 3,
  "name": "Patient monitor",
  "description": "Bedside vitals: three waveforms, the usual numerics, and the limit alarms that go with them. The one device here whose parameters have real IEEE 11073-10101 terms.",
  "device": {
    "instance_name": "monitor",
    "friendly_name": "Bedside Monitor",
    "manufacturer": "SDC Testing Toolbox",
    "manufacturer_url": "https://d-meurer.com",
    "model_name": "Vitalis 500",
    "model_number": "500",
    "firmware_version": "3.4.1"
  },
  "metrics": [
    {
      "handle": "m.abp",
      "label": "Arterial pressure",
      "kind": "waveform",
      "controllable": false,
      "section": "Haemodynamics",
      "unit": {
        "code": "266016",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "150032",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "40",
      "maximum": "160",
      "sample_period": "0.02",
      "shape": "arterial",
      "cycle_samples": 50
    },
    {
      "handle": "m.alarm_volume",
      "label": "Alarm volume",
      "kind": "choice",
      "controllable": true,
      "section": "Settings",
      "type": {
        "code": "monitor_alarm_volume",
        "system": "private"
      },
      "allowed_values": [
        "OFF",
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "initial_value": "MEDIUM"
    },
    {
      "handle": "m.display_note",
      "label": "Display note",
      "kind": "text",
      "controllable": true,
      "section": "Settings",
      "type": {
        "code": "monitor_display_note",
        "system": "private"
      }
    },
    {
      "handle": "m.ecg_ii",
      "label": "ECG lead II",
      "kind": "waveform",
      "controllable": false,
      "section": "ECG",
      "unit": {
        "code": "266418",
        "system": "mdc",
        "label": "mV"
      },
      "type": {
        "code": "131330",
        "system": "mdc"
      },
      "resolution": "0.01",
      "minimum": "-1",
      "maximum": "2",
      "sample_period": "0.008",
      "shape": "ecg",
      "cycle_samples": 125
    },
    {
      "handle": "m.heart_rate",
      "label": "Heart rate",
      "kind": "number",
      "controllable": false,
      "section": "ECG",
      "unit": {
        "code": "264864",
        "system": "mdc",
        "label": "bpm"
      },
      "type": {
        "code": "147842",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "300",
      "initial_value": "72"
    },
    {
      "handle": "m.nibp_dia",
      "label": "NIBP diastolic",
      "kind": "number",
      "controllable": false,
      "section": "Haemodynamics",
      "unit": {
        "code": "266016",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "150022",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "200",
      "initial_value": "74"
    },
    {
      "handle": "m.nibp_mean",
      "label": "NIBP mean",
      "kind": "number",
      "controllable": false,
      "section": "Haemodynamics",
      "unit": {
        "code": "266016",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "150023",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "200",
      "initial_value": "89"
    },
    {
      "handle": "m.nibp_sys",
      "label": "NIBP systolic",
      "kind": "number",
      "controllable": false,
      "section": "Haemodynamics",
      "unit": {
        "code": "266016",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "150021",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "300",
      "initial_value": "118"
    },
    {
      "handle": "m.pleth",
      "label": "Plethysmogram",
      "kind": "waveform",
      "controllable": false,
      "section": "Oximetry",
      "unit": {
        "code": "262688",
        "system": "mdc",
        "label": "%"
      },
      "type": {
        "code": "150452",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "100",
      "sample_period": "0.02",
      "shape": "pulse",
      "cycle_samples": 50
    },
    {
      "handle": "m.pulse_rate",
      "label": "Pulse rate",
      "kind": "number",
      "controllable": false,
      "section": "Oximetry",
      "unit": {
        "code": "264864",
        "system": "mdc",
        "label": "bpm"
      },
      "type": {
        "code": "149530",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "300",
      "initial_value": "74"
    },
    {
      "handle": "m.resp_rate",
      "label": "Respiration rate",
      "kind": "number",
      "controllable": false,
      "section": "Respiration",
      "unit": {
        "code": "264928",
        "system": "mdc",
        "label": "1/min"
      },
      "type": {
        "code": "151554",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "80",
      "initial_value": "14"
    },
    {
      "handle": "m.spo2",
      "label": "SpO2",
      "kind": "number",
      "controllable": false,
      "section": "Oximetry",
      "unit": {
        "code": "262688",
        "system": "mdc",
        "label": "%"
      },
      "type": {
        "code": "150456",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "100",
      "initial_value": "98"
    },
    {
      "handle": "m.temp_body",
      "label": "Body temperature",
      "kind": "number",
      "controllable": false,
      "section": "Temperature",
      "unit": {
        "code": "268192",
        "system": "mdc",
        "label": "\u00b0C"
      },
      "type": {
        "code": "150364",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "25",
      "maximum": "45",
      "initial_value": "36.8"
    }
  ],
  "alerts": [
    {
      "handle": "al.hr_out_of_range",
      "label": "Heart rate out of range",
      "watches": "m.heart_rate",
      "kind": "Phy",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "45",
      "upper_limit": "120",
      "delegable": true
    },
    {
      "handle": "al.sensor_check",
      "label": "Check oximetry sensor",
      "watches": "m.spo2",
      "kind": "Tec",
      "priority": "Lo",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ]
    },
    {
      "handle": "al.spo2_low",
      "label": "SpO2 low",
      "watches": "m.spo2",
      "kind": "Phy",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "90",
      "delegable": true
    },
    {
      "handle": "al.temp_high",
      "label": "Temperature high",
      "watches": "m.temp_body",
      "kind": "Phy",
      "priority": "Me",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "upper_limit": "38.5"
    }
  ],
  "actions": [
    {
      "handle": "act.silence_alarms",
      "label": "Silence alarms",
      "target": "mds0",
      "note": "Audio pause. In BICEPS this is an alert signal's ActivationState, so what this does here is a stand-in",
      "effects": {
        "m.alarm_volume": "OFF"
      }
    },
    {
      "handle": "act.start_nibp",
      "label": "Start NIBP measurement",
      "target": "vmd.haemodynamics",
      "note": "Inflate the cuff and take a reading now, rather than waiting for the interval",
      "effects": {
        "m.nibp_dia": "79",
        "m.nibp_mean": "94",
        "m.nibp_sys": "124"
      }
    }
  ],
  "contexts": {
    "location": {
      "facility": "HOSP",
      "building": "Surgery",
      "floor": "2",
      "point_of_care": "OR1",
      "room": "1",
      "bed": "Table"
    }
  }
}
