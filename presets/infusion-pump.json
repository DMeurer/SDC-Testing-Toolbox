{
  "version": 3,
  "name": "Infusion pump",
  "description": "Volumetric pump: rate, volume to be infused, line pressure and the alarms that make a pump a pump. Small on purpose, and the easiest of these to read end to end.",
  "device": {
    "instance_name": "pump",
    "friendly_name": "Infusion Pump",
    "manufacturer": "SDC Testing Toolbox",
    "manufacturer_url": "https://d-meurer.com",
    "model_name": "Fluvia 1",
    "model_number": "1",
    "firmware_version": "2.3.0"
  },
  "metrics": [
    {
      "handle": "m.battery",
      "label": "Battery",
      "kind": "number",
      "controllable": false,
      "section": "Status",
      "unit": {
        "code": "MDC_DIM_PERCENT",
        "system": "mdc",
        "label": "%"
      },
      "type": {
        "code": "MDC_ATTR_VMS_MDS_BATT_CHARGE",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "100",
      "initial_value": "84"
    },
    {
      "handle": "m.drug",
      "label": "Drug",
      "kind": "text",
      "controllable": true,
      "section": "Infusion",
      "type": {
        "code": "pump_drug_name",
        "system": "private"
      },
      "initial_value": "Ringer's lactate"
    },
    {
      "handle": "m.line_pressure",
      "label": "Line pressure",
      "kind": "waveform",
      "controllable": false,
      "section": "Line",
      "unit": {
        "code": "MDC_DIM_MMHG",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "pump_line_pressure",
        "system": "private"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "600",
      "sample_period": "0.1",
      "shape": "pulse",
      "cycle_samples": 30
    },
    {
      "handle": "m.occlusion_pressure",
      "label": "Occlusion limit",
      "kind": "number",
      "controllable": true,
      "section": "Line",
      "unit": {
        "code": "MDC_DIM_MMHG",
        "system": "mdc",
        "label": "mmHg"
      },
      "type": {
        "code": "pump_occlusion_limit",
        "system": "private"
      },
      "resolution": "10",
      "minimum": "100",
      "maximum": "900",
      "initial_value": "500"
    },
    {
      "handle": "m.pump_state",
      "label": "Pump state",
      "kind": "choice",
      "controllable": true,
      "section": "Infusion",
      "type": {
        "code": "pump_state",
        "system": "private"
      },
      "allowed_values": [
        "STOPPED",
        "RUNNING",
        "PAUSED",
        "KVO"
      ],
      "initial_value": "RUNNING"
    },
    {
      "handle": "m.rate",
      "label": "Infusion rate",
      "kind": "number",
      "controllable": true,
      "section": "Infusion",
      "unit": {
        "code": "MDC_DIM_MILLI_L_PER_HR",
        "system": "mdc",
        "label": "mL/h"
      },
      "type": {
        "code": "MDC_FLOW_FLUID_PUMP",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "1200",
      "initial_value": "125"
    },
    {
      "handle": "m.volume_infused",
      "label": "Volume infused",
      "kind": "number",
      "controllable": false,
      "section": "Infusion",
      "unit": {
        "code": "MDC_DIM_MILLI_L",
        "system": "mdc",
        "label": "mL"
      },
      "type": {
        "code": "MDC_VOL_FLUID_DELIV_TOTAL",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "2000",
      "initial_value": "0"
    },
    {
      "handle": "m.vtbi",
      "label": "Volume to be infused",
      "kind": "number",
      "controllable": true,
      "section": "Infusion",
      "unit": {
        "code": "MDC_DIM_MILLI_L",
        "system": "mdc",
        "label": "mL"
      },
      "type": {
        "code": "pump_volume_to_be_infused",
        "system": "private"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "2000",
      "initial_value": "500"
    }
  ],
  "alerts": [
    {
      "handle": "al.battery_low",
      "label": "Battery low",
      "watches": "m.battery",
      "kind": "Tec",
      "priority": "Me",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "20"
    },
    {
      "handle": "al.infusion_complete",
      "label": "Infusion complete",
      "watches": "m.volume_infused",
      "kind": "Tec",
      "priority": "Lo",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ]
    },
    {
      "handle": "al.occlusion",
      "label": "Downstream occlusion",
      "watches": "m.line_pressure",
      "kind": "Tec",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "upper_limit": "500",
      "delegable": true
    }
  ],
  "actions": [
    {
      "handle": "act.bolus",
      "label": "Give bolus",
      "target": "vmd.infusion",
      "note": "A fixed extra volume at a higher rate. One press, no value to type, which is what makes it an action",
      "effects": {
        "m.pump_state": "RUNNING",
        "m.rate": "600"
      }
    },
    {
      "handle": "act.clear_volume",
      "label": "Clear infused volume",
      "target": "vmd.infusion",
      "effects": {
        "m.volume_infused": "0"
      }
    },
    {
      "handle": "act.start_infusion",
      "label": "Start",
      "target": "vmd.infusion",
      "effects": {
        "m.pump_state": "RUNNING"
      }
    },
    {
      "handle": "act.stop_infusion",
      "label": "Stop",
      "target": "vmd.infusion",
      "effects": {
        "m.pump_state": "STOPPED",
        "m.rate": "0"
      }
    }
  ]
}
