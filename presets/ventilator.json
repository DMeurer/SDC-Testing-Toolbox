{
  "version": 3,
  "name": "Ventilator",
  "description": "Three synchronised waveforms and the settings behind them. The waveform-heaviest preset here, and the one that shows what a stream of sample arrays costs.",
  "device": {
    "instance_name": "ventilator",
    "friendly_name": "Ventilator",
    "manufacturer": "SDC Testing Toolbox",
    "manufacturer_url": "https://d-meurer.com",
    "model_name": "Aeris 700",
    "model_number": "700",
    "firmware_version": "4.1.2"
  },
  "metrics": [
    {
      "handle": "m.compliance",
      "label": "Compliance",
      "kind": "number",
      "controllable": false,
      "section": "Measured",
      "unit": {
        "code": "vent_compliance_unit",
        "system": "private",
        "label": "mL/cmH2O"
      },
      "type": {
        "code": "151696",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "150",
      "initial_value": "42"
    },
    {
      "handle": "m.fio2",
      "label": "FiO2",
      "kind": "number",
      "controllable": true,
      "section": "Settings",
      "unit": {
        "code": "262688",
        "system": "mdc",
        "label": "%"
      },
      "type": {
        "code": "152196",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "21",
      "maximum": "100",
      "initial_value": "40"
    },
    {
      "handle": "m.flow",
      "label": "Airway flow",
      "kind": "waveform",
      "controllable": false,
      "section": "Waveforms",
      "unit": {
        "code": "265216",
        "system": "mdc",
        "label": "L/min"
      },
      "type": {
        "code": "151764",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "-60",
      "maximum": "60",
      "sample_period": "0.02",
      "shape": "flow",
      "cycle_samples": 200
    },
    {
      "handle": "m.insp_pressure",
      "label": "Inspiratory pressure",
      "kind": "number",
      "controllable": true,
      "section": "Settings",
      "unit": {
        "code": "266048",
        "system": "mdc",
        "label": "cmH2O"
      },
      "type": {
        "code": "16929188",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "5",
      "maximum": "50",
      "initial_value": "18"
    },
    {
      "handle": "m.minute_volume",
      "label": "Minute volume",
      "kind": "number",
      "controllable": false,
      "section": "Measured",
      "unit": {
        "code": "265216",
        "system": "mdc",
        "label": "L/min"
      },
      "type": {
        "code": "151880",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "30",
      "initial_value": "6.7"
    },
    {
      "handle": "m.paw",
      "label": "Airway pressure",
      "kind": "waveform",
      "controllable": false,
      "section": "Waveforms",
      "unit": {
        "code": "266048",
        "system": "mdc",
        "label": "cmH2O"
      },
      "type": {
        "code": "151792",
        "system": "mdc"
      },
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "40",
      "sample_period": "0.02",
      "shape": "respiration",
      "cycle_samples": 200
    },
    {
      "handle": "m.peak_pressure",
      "label": "Peak pressure",
      "kind": "number",
      "controllable": false,
      "section": "Measured",
      "unit": {
        "code": "266048",
        "system": "mdc",
        "label": "cmH2O"
      },
      "type": {
        "code": "151817",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "60",
      "initial_value": "23"
    },
    {
      "handle": "m.peep",
      "label": "PEEP",
      "kind": "number",
      "controllable": true,
      "section": "Settings",
      "unit": {
        "code": "266048",
        "system": "mdc",
        "label": "cmH2O"
      },
      "type": {
        "code": "151804",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "25",
      "initial_value": "5"
    },
    {
      "handle": "m.resp_rate_set",
      "label": "Set rate",
      "kind": "number",
      "controllable": true,
      "section": "Settings",
      "unit": {
        "code": "264928",
        "system": "mdc",
        "label": "1/min"
      },
      "type": {
        "code": "16928802",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "4",
      "maximum": "60",
      "initial_value": "14"
    },
    {
      "handle": "m.tidal_volume",
      "label": "Tidal volume",
      "kind": "number",
      "controllable": false,
      "section": "Measured",
      "unit": {
        "code": "263762",
        "system": "mdc",
        "label": "mL"
      },
      "type": {
        "code": "151868",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "1500",
      "initial_value": "480"
    },
    {
      "handle": "m.vent_mode",
      "label": "Ventilation mode",
      "kind": "choice",
      "controllable": true,
      "section": "Settings",
      "type": {
        "code": "184352",
        "system": "mdc"
      },
      "allowed_values": [
        "VC_CMV",
        "PC_CMV",
        "SIMV",
        "CPAP",
        "PSV",
        "STANDBY"
      ],
      "initial_value": "PC_CMV"
    },
    {
      "handle": "m.volume",
      "label": "Airway volume",
      "kind": "waveform",
      "controllable": false,
      "section": "Waveforms",
      "unit": {
        "code": "263762",
        "system": "mdc",
        "label": "mL"
      },
      "type": {
        "code": "152708",
        "system": "mdc"
      },
      "resolution": "1",
      "minimum": "0",
      "maximum": "800",
      "sample_period": "0.02",
      "shape": "respiration",
      "cycle_samples": 200
    }
  ],
  "alerts": [
    {
      "handle": "al.disconnection",
      "label": "Patient disconnected",
      "watches": "m.peak_pressure",
      "kind": "Tec",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "3"
    },
    {
      "handle": "al.minute_volume_low",
      "label": "Minute volume low",
      "watches": "m.minute_volume",
      "kind": "Phy",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "3",
      "delegable": true
    },
    {
      "handle": "al.pressure_high",
      "label": "Airway pressure high",
      "watches": "m.peak_pressure",
      "kind": "Phy",
      "priority": "Hi",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "upper_limit": "35",
      "delegable": true
    },
    {
      "handle": "al.tidal_volume_out_of_range",
      "label": "Tidal volume out of range",
      "watches": "m.tidal_volume",
      "kind": "Phy",
      "priority": "Me",
      "signals": [
        {
          "manifestation": "Vis",
          "latching": false
        },
        {
          "manifestation": "Aud",
          "latching": false
        }
      ],
      "lower_limit": "250",
      "upper_limit": "750"
    }
  ],
  "actions": [
    {
      "handle": "act.insp_hold",
      "label": "Inspiratory hold",
      "target": "vmd.waveforms",
      "note": "Hold at end of inspiration to measure plateau pressure and static compliance",
      "effects": {
        "m.compliance": "44.5",
        "m.peak_pressure": "21"
      }
    },
    {
      "handle": "act.o2_flush",
      "label": "100% O2 for 2 minutes",
      "target": "vmd.settings",
      "note": "Pre-oxygenation before suctioning",
      "effects": {
        "m.fio2": "100"
      }
    },
    {
      "handle": "act.recruitment",
      "label": "Recruitment manoeuvre",
      "target": "mds0",
      "note": "A sustained inflation. There is no value to set: it is a procedure the device performs",
      "effects": {
        "m.peak_pressure": "38",
        "m.tidal_volume": "620"
      }
    },
    {
      "handle": "act.standby",
      "label": "Standby",
      "target": "mds0",
      "note": "Stop ventilating without powering down",
      "effects": {
        "m.minute_volume": "0",
        "m.peak_pressure": "0",
        "m.vent_mode": "STANDBY"
      }
    }
  ]
}
