        <ext:Extension>
          <tb:Device FriendlyName="Endoscopic Camera" FirmwareVersion="5.2.0" ext:MustUnderstand="false"/>
          <tb:Preset Name="Endoscopic camera" Description="Camera control unit and its light source: image processing settings, white balance, and the colour temperature of the illumination." ext:MustUnderstand="false"/>
        </ext:Extension>
        <dom:Type Code="toolbox-mds" CodingSystem="urn:sdc-testing-toolbox:private">
          <dom:ConceptDescription Lang="en-US">SDC-testing-toolbox virtual device</dom:ConceptDescription>
        </dom:Type>
        <dom:AlertSystem Handle="alerts.mds0" SelfCheckPeriod="PT30S">
          <dom:AlertCondition Handle="al.lamp_service" xsi:type="dom:LimitAlertConditionDescriptor" Kind="Tec" Priority="Lo">
            <dom:Type Code="lamp_service_due" CodingSystem="urn:sdc-testing-toolbox:private">
              <dom:ConceptDescription Lang="en-US">Lamp service due</dom:ConceptDescription>
            </dom:Type>
            <dom:Source>m.lamp_hours</dom:Source>
            <dom:MaxLimits Lower="0" Upper="20000"/>
          </dom:AlertCondition>
          <dom:AlertCondition Handle="al.image_too_dark" xsi:type="dom:LimitAlertConditionDescriptor" Kind="Tec" Priority="Me">
            <dom:Type Code="image_too_dark" CodingSystem="urn:sdc-testing-toolbox:private">
              <dom:ConceptDescription Lang="en-US">Image too dark</dom:ConceptDescription>
            </dom:Type>
            <dom:Source>m.light_intensity</dom:Source>
            <dom:MaxLimits Lower="0" Upper="100"/>
          </dom:AlertCondition>
          <dom:AlertSignal Handle="sig.image_too_dark.vis" ConditionSignaled="al.image_too_dark" Manifestation="Vis" Latching="false" SignalDelegationSupported="false"/>
          <dom:AlertSignal Handle="sig.image_too_dark.aud" ConditionSignaled="al.image_too_dark" Manifestation="Aud" Latching="false" SignalDelegationSupported="false"/>
          <dom:AlertSignal Handle="sig.lamp_service_due.aud" ConditionSignaled="al.lamp_service" Manifestation="Aud" Latching="false" SignalDelegationSupported="false"/>
          <dom:AlertSignal Handle="sig.lamp_service_due.vis" ConditionSignaled="al.lamp_service" Manifestation="Vis" Latching="false" SignalDelegationSupported="false"/>
        </dom:AlertSystem>
        <dom:Sco Handle="sco.mds0">
          <dom:Operation Handle="act.lamp_standby" xsi:type="dom:ActivateOperationDescriptor" OperationTarget="vmd.light_source">
            <ext:Extension>
              <tb:Action Note="Drop the lamp out of the light path without switching it off" ext:MustUnderstand="false">
                <tb:Effect Target="m.light_intensity" Value="0"/>
                <tb:Effect Target="m.light_state" Value="STANDBY"/>
