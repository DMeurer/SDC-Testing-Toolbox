            </ext:Extension>
            <dom:Type Code="lamp_to_standby" CodingSystem="urn:sdc-testing-toolbox:private">
              <dom:ConceptDescription Lang="en-US">Lamp to standby</dom:ConceptDescription>
            </dom:Type>
          </dom:Operation>
          <dom:Operation Handle="op.gain" xsi:type="dom:SetValueOperationDescriptor" OperationTarget="m.gain">
            <dom:Type Code="set_cam_gain" CodingSystem="urn:sdc-testing-toolbox:private"/>
          </dom:Operation>
          <dom:Operation Handle="op.image_profile" xsi:type="dom:SetStringOperationDescriptor" OperationTarget="m.image_profile">
