          </dom:Operation>
          <dom:Operation Handle="op.white_balance" xsi:type="dom:SetValueOperationDescriptor" OperationTarget="m.white_balance">
            <dom:Type Code="set_cam_white_balance" CodingSystem="urn:sdc-testing-toolbox:private"/>
          </dom:Operation>
          <dom:Operation Handle="op.light_intensity" xsi:type="dom:SetValueOperationDescriptor" OperationTarget="m.light_intensity">
            <dom:Type Code="set_light_intensity" CodingSystem="urn:sdc-testing-toolbox:private"/>
          </dom:Operation>
          <dom:Operation Handle="op.light_state" xsi:type="dom:SetStringOperationDescriptor" OperationTarget="m.light_state">
            <dom:Type Code="set_light_state" CodingSystem="urn:sdc-testing-toolbox:private"/>
          </dom:Operation>
          <dom:Operation Handle="act.capture_still" xsi:type="dom:ActivateOperationDescriptor" OperationTarget="vmd.camera">
            <ext:Extension>
              <tb:Action Note="SDC carries no image data, so this only records that a capture happened" ext:MustUnderstand="false"/>
            </ext:Extension>
            <dom:Type Code="capture_still" CodingSystem="urn:sdc-testing-toolbox:private">
              <dom:ConceptDescription Lang="en-US">Capture still</dom:ConceptDescription>
            </dom:Type>
          </dom:Operation>
          <dom:Operation Handle="op.exposure" xsi:type="dom:SetValueOperationDescriptor" OperationTarget="m.exposure">
            <dom:Type Code="set_cam_exposure_time" CodingSystem="urn:sdc-testing-toolbox:private"/>
          </dom:Operation>
          <dom:Operation Handle="act.white_balance" xsi:type="dom:ActivateOperationDescriptor" OperationTarget="vmd.camera">
            <ext:Extension>
              <tb:Action Note="Point at a white swab and press. Nothing to write: the device works out the value" ext:MustUnderstand="false">
                <tb:Effect Target="m.gain" Value="6"/>
                <tb:Effect Target="m.white_balance" Value="5600"/>
              </tb:Action>
            </ext:Extension>
            <dom:Type Code="white_balance_now" CodingSystem="urn:sdc-testing-toolbox:private">
              <dom:ConceptDescription Lang="en-US">White balance now</dom:ConceptDescription>
            </dom:Type>
          </dom:Operation>
          <dom:Operation Handle="op.enhancement" xsi:type="dom:SetStringOperationDescriptor" OperationTarget="m.enhancement">
            <dom:Type Code="set_cam_enhancement_mode" CodingSystem="urn:sdc-testing-toolbox:private"/>
          </dom:Operation>
        </dom:Sco>
