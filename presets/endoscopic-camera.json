{
  "version": 1,
  "name": "Endoscopic camera",
  "description": "Camera control unit and its light source: image processing settings, white balance, and the colour temperature of the illumination.",
  "device": {
    "instance_name": "endoscope",
    "friendly_name": "Endoscopic Camera",
    "manufacturer": "SDC Testing Toolbox",
    "model_name": "Endovision 4K",
    "model_number": "4K-2",
    "firmware_version": "5.2.0"
  },
  "metrics": [
    {
      "handle": "m.image_profile",
      "label": "Image profile",
      "kind": "choice",
      "section": "Camera",
      "controllable": true,
      "allowed_values": ["LAPAROSCOPY", "ARTHROSCOPY", "HYSTEROSCOPY", "UROLOGY", "ENT"],
      "initial_value": "LAPAROSCOPY",
      "type": {"code": "cam_image_profile", "system": "private"}
    },
    {
      "handle": "m.enhancement",
      "label": "Contrast enhancement",
      "kind": "choice",
      "section": "Camera",
      "controllable": true,
      "allowed_values": ["OFF", "TISSUE", "VESSEL", "FLUORESCENCE"],
      "initial_value": "OFF",
      "type": {"code": "cam_enhancement_mode", "system": "private"}
    },
    {
      "handle": "m.gain",
      "label": "Gain",
      "kind": "number",
      "section": "Camera",
      "controllable": true,
      "unit": {"label": "dB", "code": "MDC_DIM_DECIBEL", "system": "mdc"},
      "type": {"code": "cam_gain", "system": "private"},
      "resolution": "0.5",
      "minimum": "0",
      "maximum": "24",
      "initial_value": "6"
    },
    {
      "handle": "m.exposure",
      "label": "Exposure time",
      "kind": "number",
      "section": "Camera",
      "controllable": true,
      "unit": {"label": "ms", "code": "MDC_DIM_MILLI_SEC", "system": "mdc"},
      "type": {"code": "cam_exposure_time", "system": "private"},
      "resolution": "0.1",
      "minimum": "0.5",
      "maximum": "40",
      "initial_value": "8"
    },
    {
      "handle": "m.white_balance",
      "label": "White balance",
      "kind": "number",
      "section": "Camera",
      "controllable": true,
      "unit": {"label": "K", "code": "MDC_DIM_KELVIN", "system": "mdc"},
      "type": {"code": "cam_white_balance", "system": "private"},
      "resolution": "50",
      "minimum": "2800",
      "maximum": "7500",
      "initial_value": "5600"
    },
    {
      "handle": "m.brightness_trace",
      "label": "Scene brightness",
      "kind": "waveform",
      "section": "Camera",
      "controllable": false,
      "unit": {"label": "%", "code": "MDC_DIM_PERCENT", "system": "mdc"},
      "type": {"code": "cam_scene_brightness", "system": "private"},
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "100",
      "sample_period": "0.04",
      "shape": "noise",
      "cycle_samples": 30
    },
    {
      "handle": "m.colour_histogram",
      "label": "Luminance histogram",
      "kind": "distribution",
      "section": "Camera",
      "controllable": false,
      "unit": {"label": "px", "code": "cam_pixel_count", "system": "private"},
      "type": {"code": "cam_luminance_histogram", "system": "private"},
      "resolution": "1",
      "minimum": "0",
      "maximum": "5000",
      "domain_unit": {"label": "level", "code": "cam_luminance_level", "system": "private"},
      "domain_minimum": "0",
      "domain_maximum": "255",
      "distribution_shape": "bell"
    },
    {
      "handle": "m.light_intensity",
      "label": "Light intensity",
      "kind": "number",
      "section": "Light source",
      "controllable": true,
      "unit": {"label": "%", "code": "MDC_DIM_PERCENT", "system": "mdc"},
      "type": {"code": "light_intensity", "system": "private"},
      "resolution": "1",
      "minimum": "0",
      "maximum": "100",
      "initial_value": "70"
    },
    {
      "handle": "m.light_state",
      "label": "Lamp",
      "kind": "choice",
      "section": "Light source",
      "controllable": true,
      "allowed_values": ["OFF", "STANDBY", "ON"],
      "initial_value": "ON",
      "type": {"code": "light_state", "system": "private"}
    },
    {
      "handle": "m.lamp_hours",
      "label": "Lamp hours",
      "kind": "number",
      "section": "Light source",
      "controllable": false,
      "unit": {"label": "h", "code": "MDC_DIM_HR", "system": "mdc"},
      "type": {"code": "light_lamp_hours", "system": "private"},
      "resolution": "1",
      "minimum": "0",
      "maximum": "20000",
      "initial_value": "1840"
    },
    {
      "handle": "m.light_spectrum",
      "label": "Light spectrum",
      "kind": "distribution",
      "section": "Light source",
      "controllable": false,
      "unit": {"label": "rel.", "code": "light_relative_intensity", "system": "private"},
      "type": {"code": "light_spectrum", "system": "private"},
      "resolution": "0.1",
      "minimum": "0",
      "maximum": "100",
      "domain_unit": {"label": "nm", "code": "MDC_DIM_NANO_M", "system": "mdc"},
      "domain_minimum": "380",
      "domain_maximum": "780",
      "distribution_shape": "bimodal"
    }
  ],
  "alerts": [
    {
      "handle": "al.lamp_service",
      "label": "Lamp service due",
      "watches": "m.lamp_hours",
      "kind": "Tec",
      "priority": "Lo",
      "upper_limit": "5000"
    },
    {
      "handle": "al.image_too_dark",
      "label": "Image too dark",
      "watches": "m.light_intensity",
      "kind": "Tec",
      "priority": "Me",
      "lower_limit": "15"
    }
  ],
  "actions": [
    {
      "handle": "act.white_balance",
      "label": "White balance now",
      "target": "vmd.camera",
      "note": "Point at a white swab and press. Nothing to write: the device works out the value",
      "effects": {"m.white_balance": "5600", "m.gain": "6"}
    },
    {
      "handle": "act.capture_still",
      "label": "Capture still",
      "target": "vmd.camera",
      "note": "SDC carries no image data, so this only records that a capture happened",
      "effects": {}
    },
    {
      "handle": "act.lamp_standby",
      "label": "Lamp to standby",
      "target": "vmd.light_source",
      "note": "Drop the lamp out of the light path without switching it off",
      "effects": {"m.light_state": "STANDBY", "m.light_intensity": "0"}
    }
  ]
}
